<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <Authors>OmniFlow Team</Authors>
    <Description>MongoDB adapters for OmniFlow framework (idempotency store and saga repository)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniFlow.Idempotency\OmniFlow.Idempotency.csproj" />
    <ProjectReference Include="..\OmniFlow.Sagas\OmniFlow.Sagas.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
  </ItemGroup>

</Project>
