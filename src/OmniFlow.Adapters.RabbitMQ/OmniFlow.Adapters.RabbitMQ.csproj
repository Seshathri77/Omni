<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <Authors>OmniFlow Team</Authors>
    <Description>RabbitMQ message bus adapter for OmniFlow framework</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniFlow.Core\OmniFlow.Core.csproj" />
    <ProjectReference Include="..\OmniFlow.Messaging\OmniFlow.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
  </ItemGroup>

</Project>
