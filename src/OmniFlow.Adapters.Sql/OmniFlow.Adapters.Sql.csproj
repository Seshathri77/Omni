<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <Authors>OmniFlow Team</Authors>
    <Description>SQL-based saga repository and idempotency store for OmniFlow framework</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniFlow.Core\OmniFlow.Core.csproj" />
    <ProjectReference Include="..\OmniFlow.Sagas\OmniFlow.Sagas.csproj" />
    <ProjectReference Include="..\OmniFlow.Idempotency\OmniFlow.Idempotency.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0" />
  </ItemGroup>

</Project>
